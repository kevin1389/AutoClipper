# ---------------------------------------------------------------------------
# AutoClipper configuration
# Copy to .env and fill in the values you have. Browser processing works with
# no keys: FFmpeg.wasm and quantized Whisper run in the user's browser.
# ---------------------------------------------------------------------------

# Local development data directory. Production uses D1 plus the optional S3
# provider pool below. The legacy R2 FILES binding and existing r2:// objects
# remain readable.
# AC_DATA_DIR=./data

# Accepted source ceiling. The normal path keeps the source in the browser and
# mounts it read-only; the UI and APIs enforce at most 1,024 MB (1 GiB).
# AC_MAX_UPLOAD_MB=1024

# Legacy R2 allowance used only when no S3 provider is configured. This
# controls the display only; it does not raise the platform quota or change
# upload limits.
# AC_R2_STORAGE_LIMIT_BYTES=1000000000

# ---------------------------------------------------------------------------
# Browser assets (FFmpeg.wasm, ONNX Runtime, Whisper, caption font)
#
# These ~205 MB of files cannot be Cloudflare Worker assets (25 MiB per-file
# limit). Host them in a public bucket/CDN and point this at the directory that
# contains ffmpeg/, transformers/, models/ and fonts/. The default is the
# same-origin /api/browser-assets route, which reads the R2 FILES binding (or
# browser-assets/ on disk in local development).
#
# A public base URL needs no storage credentials in the deployed Worker. The
# bucket must allow public GET/HEAD and the CORS rules in
# scripts/browser-assets-cors.json. Use npm run assets:upload to upload.
#
# B2 friendly-URL example:
# BROWSER_ASSET_BASE_URL=https://f004.backblazeb2.com/file/ac-browser-assets/browser-assets/v1/
# BROWSER_ASSET_BASE_URL=/api/browser-assets/
#
# A public base may use a versioned prefix (bump v1 when assets change). The
# same-origin route resolves exact manifest paths, so its R2 objects belong at
# browser-assets/<path> without a version segment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional S3-compatible object-storage pool
#
# New objects are placed in Backblaze B2 first, then Tigris, then Filebase.
# Each provider is optional and configured independently. These credentials are
# server-only: never put them in client code or NEXT_PUBLIC_* variables. Locally
# keep them only in this untracked .env file; on a hosted deployment use its
# encrypted secret store (for Sites: Settings → Secrets). Never commit .env.
#
# AutoClipper does not create accounts, activate free tiers, upgrade plans or
# add payment methods. Create and verify each free account yourself, and use a
# dedicated bucket for AutoClipper. Confirm current free-tier terms in the
# provider dashboard before relying on them. No paid provider is used as a
# fallback.
# ---------------------------------------------------------------------------

# Backblaze B2. ENDPOINT defaults to https://s3.<REGION>.backblazeb2.com.
# AC_B2_ACCESS_KEY_ID=
# AC_B2_SECRET_ACCESS_KEY=
# AC_B2_BUCKET=
# AC_B2_REGION=us-west-004
# AC_B2_ENDPOINT=
# AC_B2_SESSION_TOKEN=

# Tigris defaults to https://t3.storage.dev and region auto.
# AC_TIGRIS_ACCESS_KEY_ID=
# AC_TIGRIS_SECRET_ACCESS_KEY=
# AC_TIGRIS_BUCKET=
# AC_TIGRIS_REGION=auto
# AC_TIGRIS_ENDPOINT=https://t3.storage.dev
# AC_TIGRIS_SESSION_TOKEN=

# Filebase defaults to https://s3.filebase.io and region auto.
# AC_FILEBASE_ACCESS_KEY_ID=
# AC_FILEBASE_SECRET_ACCESS_KEY=
# AC_FILEBASE_BUCKET=
# AC_FILEBASE_REGION=auto
# AC_FILEBASE_ENDPOINT=https://s3.filebase.io
# AC_FILEBASE_SESSION_TOKEN=

# Optional safety overrides. Values are decimal bytes. Defaults leave a reserve
# below each free tier: B2 9 GB of 10 GB, Tigris 4.5 GB of 5 GB, Filebase
# 4.5 GB of 5 GB, for an 18 GB aggregate target. The free-tier allowance is a
# hard ceiling: _LIMIT_BYTES and AC_STORAGE_TARGET_BYTES can only lower it.
#
# Provider listing is metered (Tigris includes 10,000 Class A requests/month),
# so measurements are cached in D1 and upload reservations never list. These
# only need changing if you want even fewer provider requests.
# AC_STORAGE_MEASURE_TTL_MS=1800000
# AC_STORAGE_FAILED_MEASURE_TTL_MS=300000
# AC_STORAGE_LIST_COOLDOWN_MS=600000
#
# Daily reconciliation refreshes each provider once a day (never more), keeps
# the last good numbers when a listing fails, and defers a provider while an
# upload is active. A failed run retries after AC_STORAGE_RECONCILE_RETRY_MS;
# AC_STORAGE_RECONCILE_LEASE_MS bounds a single run across Workers.
# AC_STORAGE_RECONCILE_INTERVAL_MS=86400000
# AC_STORAGE_RECONCILE_RETRY_MS=21600000
# AC_STORAGE_RECONCILE_DEFER_MS=900000
# AC_STORAGE_RECONCILE_LEASE_MS=120000
#
# Secret for POST/GET /api/storage/reconcile. Use at least 32 characters of
# random data (for example: openssl rand -base64 32); shorter values are
# refused because the endpoint is otherwise unauthenticated. Store it in the
# server secret store and send it from your scheduler as
#   Authorization: Bearer <secret>
# Leave unset and the endpoint refuses every request. The dashboard also starts
# a due reconciliation after a storage read, so an external cron is optional.
# Requests are throttled durably: 30 per client address and 20 authenticated
# runs per 15 minutes by default, shared across every Worker.
# AC_RECONCILE_SECRET=
# AC_RECONCILE_CLIENT_LIMIT=30
# AC_RECONCILE_RATE_LIMIT=20
# AC_RECONCILE_RATE_WINDOW_MS=900000
# Provider attempts per upload, including failover to the next provider.
# AC_UPLOAD_PROVIDER_ATTEMPTS=3
# AC_B2_LIMIT_BYTES=10000000000
# AC_B2_RESERVE_BYTES=1000000000
# AC_TIGRIS_LIMIT_BYTES=5000000000
# AC_TIGRIS_RESERVE_BYTES=500000000
# AC_FILEBASE_LIMIT_BYTES=5000000000
# AC_FILEBASE_RESERVE_BYTES=500000000
# AC_STORAGE_TARGET_BYTES=18000000000
# AC_S3_TIMEOUT_MS=45000
# Expired upload/multipart reservations are aborted and released after this.
# AC_STORAGE_RESERVATION_TTL_MS=86400000

# Path-style requests are the default. Set to 0 only if the provider requires
# virtual-hosted-style bucket URLs.
# AC_B2_PATH_STYLE=1
# AC_TIGRIS_PATH_STYLE=1
# AC_FILEBASE_PATH_STYLE=1

# ---------------------------------------------------------------------------
# Accounts and email
#
# APP_ORIGIN is the exact public origin used for emailed links, the Google
# redirect URI and CSRF checks. It defaults to http://localhost:3000 outside
# production.
#
# Resend is optional for local testing; without it, verification is skipped and
# password-reset email cannot be sent. Never pretend an email was sent.
# ---------------------------------------------------------------------------
# APP_ORIGIN=http://localhost:3000
# RESEND_API_KEY=
# EMAIL_FROM=AutoClipper <no-reply@your-domain.example>

# Credential throttling is stored in the shared database (D1 in production), so
# an attempt counted by one Worker counts against every Worker. The account
# bucket is keyed by email and cannot be spoofed; the client bucket is keyed by
# the proxy-supplied address. Defaults: 10 attempts per account and 30 per
# client per 15 minutes.
# AC_SIGNIN_ACCOUNT_LIMIT=10
# AC_SIGNIN_CLIENT_LIMIT=30
# AC_SIGNIN_RATE_WINDOW_MS=900000

# Optional Google sign-in. Redirect URI:
#   ${APP_ORIGIN}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# YouTube
#
# Metadata comes from public oEmbed. YouTube provides no download API, and
# extractors (yt-dlp, cobalt, etc.) are intentionally unsupported.
#
# For the one-step path, provision media you own or are licensed to use:
#   YOUTUBE_MEDIA_DIR/<video-id>.mp4
# Supported extensions: .mp4 .mov .m4v .webm .mkv
# ---------------------------------------------------------------------------
# YOUTUBE_CONTENT_PROVIDER=none
# YOUTUBE_MEDIA_DIR=./youtube-media
# YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Tests only. Ignored when NODE_ENV=production.
# ---------------------------------------------------------------------------
# AC_MAIL_OUTBOX=1
# AC_ALLOW_TEST_AUTH=1
# AC_TEST_AUTH_USERS={"token-a":{"sub":"sub-a","email":"a@example.test"},"token-b":{"sub":"sub-b"}}
